<odoo>
    <record id="view_partner_form_comercial_autoasign" model="ir.ui.view">
        <field name="name">res.partner.form.comercial.autoasign</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="keep_salesperson" widget="boolean_toggle" />
            </xpath>
        </field>
    </record>
</odoo>
