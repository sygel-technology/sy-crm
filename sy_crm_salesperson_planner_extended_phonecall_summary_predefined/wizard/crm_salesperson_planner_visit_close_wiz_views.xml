<odoo>
    <record id="crm_salesperson_planner_visit_close_wiz_view_form" model="ir.ui.view">
        <field name="name">
            crm.salesperson.planner.visit.close.wiz.form.inherit.summary.predefined
        </field>
        <field name="model">crm.salesperson.planner.visit.close.wiz</field>
        <field
            name="inherit_id"
            ref="sy_crm_salesperson_planner_extended_phonecall.crm_salesperson_planner_visit_close_wiz_view_form"
        />
        <field name="arch" type="xml">
            <field name="phonecall_name" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>
            <field name="phonecall_name" position="after">
                <field
                    name="phonecall_summary_id"
                    invisible="not allow_reschedule or not reschedule or reschedule_model != 'phonecall'"
                    required="allow_reschedule and reschedule and reschedule_model == 'phonecall'"
                />
            </field>
        </field>
    </record>
</odoo>
